# Copy this file to .env and fill it in:   cp .env.example .env
# .env is gitignored. Never commit real credentials.
# Run with the settings loaded:            uv run --env-file .env <command>

# Which implementation serves each vertical. Each name is an entry in
# src/meeting_prep/factories.py:
#   storage    team6-s3 | fake | fake-failing
#   tracker    team4-trello | fake | fake-failing
#   calendar   team5-google | fake | fake-failing
# fake keeps everything in memory. fake-failing refuses every call, so staging
# can show how a provider failure is reported.
STORAGE_PROVIDER=fake
TRACKER_PROVIDER=fake
CALENDAR_PROVIDER=fake

# The database. SQLite for local development; the Neon connection string when
# deployed (postgresql://... or postgres://... both work).
DATABASE_URL=sqlite:///dev.sqlite3

# Shared test-account key for the fixed Milestone 1 API only.
PRODUCT_API_KEY=
# Optional deployed commit shown by GET /health.
RELEASE=

# Signed-in API and agent. Use the same public HTTPS origin and database.
PUBLIC_ORIGIN=
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
# API origin reached by the agent. HTTPS, or HTTP for loopback testing.
MEETING_API_URL=
# Fake is for tests. Disconnected never uses the demo's tracker or calendar.
USER_PROVIDERS=disconnected
# Optional dedicated product bucket for per-user document reads and writes.
USER_STORAGE_PROVIDER=

# team6-s3: the same settings as the storage service (../.env.example), pointing
# at a bucket used only by this product.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# team4-trello: Team 4's package reads these from the environment on every call.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# team5-google: an authorized token file for the Google test account, made with
#   uv run python -m team5_calendar.authorize
CALENDAR_TOKEN_FILE=

# The agent service's model (Groq). Only the agent service reads these; the
# orchestrator and the API service start without them.
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-120b

# Only for the postgres tests (uv run pytest -m postgres): any Postgres database
# you can create schemas in. Each test works in a schema of its own and drops it.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
