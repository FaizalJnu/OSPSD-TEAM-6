# Copy this file to .env and fill it in:   cp .env.example .env
# .env is gitignored. Never commit real credentials.

# Which storage backend to use:
#   s3     an S3-compatible provider (OCI Object Storage, AWS S3, Google Cloud Storage)
#   memory files live in RAM and vanish on restart; for trying the API without a provider
STORAGE_BACKEND=s3

# Largest upload accepted, in bytes. Default is 1073741824 (1 GiB).
# MAX_UPLOAD_BYTES=1073741824

# S3-compatible provider settings (only needed when STORAGE_BACKEND=s3).
# For OCI Object Storage:
#   S3_ENDPOINT   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#   S3_REGION     the region identifier, for example us-ashburn-1
#   S3_ACCESS_KEY and S3_SECRET_KEY come from a "Customer secret key" on your OCI user profile
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Uploads are saved to a temp file before they go to the provider. On systems where
# /tmp lives in RAM (Fedora does this by default), point this at a real disk:
# TMPDIR=/var/tmp
